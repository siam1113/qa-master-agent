{
  "name": "qa-master-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready MVP foundation for AI-powered onboarding, exploratory QA, and application intelligence.",
  "type": "module",
  "scripts": {
    "dev": "sh -c 'npm run server:dev & npm run client:dev'",
    "server:dev": "node --watch server/index.js",
    "client:dev": "npm --prefix client run dev",
    "start": "node server/index.js",
    "build": "npm --prefix client run build",
    "test": "node server/tests/knowledgeGraph.test.js",
    "test:server": "node server/tests/knowledgeGraph.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "ws": "^8.18.0"
  }
}
